  m_text: "\u041D\u0443 \u0438 \u0434\u0435\u043B\u0430!\n\u041A\u0442\u043E-\u0442\u043E
    \u043D\u0435 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u043B \u043F\u043E\u043B\u043A\u0438
    \u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u043E\u0439 \u0441\u043C\u0435\u043D\u0435.
    \u041D\u0430 \u044D\u0442\u043E\u043C \u0443\u0440\u043E\u0432\u043D\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
    \u0443\u0441\u043F\u0435\u0432\u0430\u0442\u044C \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0442\u044C
    \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0435\u0439 \u0438 \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0442\u044C
    \u043F\u043E\u043B\u043A\u0438 (\u0441\u0434\u0435\u043B\u0430\u0439 \u044D\u0442\u043E
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043A\u043E\u0440\u043E\u0431\u043A\u0438
    \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435).\n\u0423\u0434\u0430\u0447\u0438!"
